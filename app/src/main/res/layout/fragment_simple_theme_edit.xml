<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/preview_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/circle_shape"
            android:elevation="0dp"
            android:padding="20dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent">

            <com.therxmv.preview.ChatsListPreview
                android:id="@+id/chat_list_preview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.45" />

            <com.therxmv.preview.ChatPreview
                android:id="@+id/chat_preview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.45" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/advanced_edit_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/advanced_edit_button"
            app:layout_constraintBottom_toBottomOf="@id/preview_background"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/picker_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/button_gradient_background"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            app:layout_constraintTop_toBottomOf="@+id/preview_background">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/picker_label"
                android:textColor="?attr/colorSurface"
                android:textSize="22sp"
                android:textStyle="normal" />

            <View
                android:id="@+id/picker_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@android:color/black"
                android:foreground="@drawable/color_picker_button"
                android:foregroundTint="@android:color/white" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_gradient_background"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            app:layout_constraintTop_toBottomOf="@+id/picker_container">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/more_label"
                android:textColor="?attr/colorSurface"
                android:textSize="22sp"
                android:textStyle="normal" />

            <ImageView
                android:id="@+id/more_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:contentDescription="@string/more_label"
                android:src="@drawable/ic_more_24" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/platform_selector_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/platform_selector_border"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@+id/more_container">

            <!--
                Sliding pill: pinned to the start edge (width = 50% of the row) and
                positioned/animated purely via translationX in code, see SimpleThemeEditFragment.
                Deliberately NOT also constrained to the end edge - that would center it
                (default 0.5 bias) instead of anchoring it to the left, breaking translationX math.
            -->
            <View
                android:id="@+id/platform_selector_indicator"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/platform_button_selected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/android_platform_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/platform_android_label"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:layout_constraintEnd_toStartOf="@+id/ios_platform_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ios_platform_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/platform_ios_label"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/android_platform_button"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/space_filler"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/export_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/platform_selector_container" />

        <LinearLayout
            android:id="@+id/export_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/button_background"
            android:gravity="center"
            android:minHeight="54dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_label"
                android:textColor="?attr/colorSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>