{
  "_comment": "Foreground/background key pairs for the Android (.attheme) template, extending the roles already curated in app/src/main/java/com/therxmv/telegramthemer/data/adapter/ThemeToPreviewAdapter.kt (the source of truth for which pairs the app itself treats as one visual unit) with a few more obvious ones found by inspecting theme-wizard/templates/android. 'role:X' as bg/fg means look the value up directly from the resolved tint schema (get_tinted_color_schema) instead of a template key - used for canonical surfaces like tt_background that many keys share 1:1.",
  "text_pairs": [
    {"id": "appbar_title", "bg": "actionBarDefault", "fg": "actionBarDefaultTitle", "kind": "text"},
    {"id": "appbar_subtitle", "bg": "actionBarDefault", "fg": "actionBarDefaultSubtitle", "kind": "text"},
    {"id": "appbar_icon", "bg": "actionBarDefault", "fg": "actionBarDefaultIcon", "kind": "icon"},
    {"id": "appbar_archived_title", "bg": "actionBarDefaultArchived", "fg": "actionBarDefaultArchivedTitle", "kind": "text"},
    {"id": "appbar_archived_icon", "bg": "actionBarDefaultArchived", "fg": "actionBarDefaultArchivedIcon", "kind": "icon"},
    {"id": "tab_unselected", "bg": "actionBarDefault", "fg": "actionBarTabUnactiveText", "kind": "text"},
    {"id": "tab_selected", "bg": "actionBarDefault", "fg": "actionBarTabActiveText", "kind": "text"},
    {"id": "chatlist_name", "bg": "role:tt_background", "fg": "chats_name", "kind": "text"},
    {"id": "chatlist_message", "bg": "role:tt_background", "fg": "chats_message", "kind": "text"},
    {"id": "chatlist_sender_name", "bg": "role:tt_background", "fg": "chats_nameMessage", "kind": "text"},
    {"id": "chatlist_date", "bg": "role:tt_background", "fg": "chats_date", "kind": "text"},
    {"id": "chatlist_action_message", "bg": "role:tt_background", "fg": "chats_actionMessage", "kind": "text"},
    {"id": "unread_counter", "bg": "chats_unreadCounter", "fg": "chats_unreadCounterText", "kind": "text"},
    {"id": "unread_counter_muted", "bg": "chats_unreadCounterMuted", "fg": "chats_unreadCounterText", "kind": "text"},
    {"id": "in_bubble_text", "bg": "chat_inBubble", "fg": "chat_messageTextIn", "kind": "text"},
    {"id": "out_bubble_text", "bg": "chat_outBubble", "fg": "chat_messageTextOut", "kind": "text"},
    {"id": "in_reply_sender", "bg": "chat_inBubble", "fg": "chat_inReplyNameText", "kind": "text"},
    {"id": "in_reply_text", "bg": "chat_inBubble", "fg": "chat_inReplyMessageText", "kind": "text"},
    {"id": "out_reply_sender", "bg": "chat_outBubble", "fg": "chat_outReplyNameText", "kind": "text"},
    {"id": "out_reply_text", "bg": "chat_outBubble", "fg": "chat_outReplyMessageText", "kind": "text"},
    {"id": "in_file_name", "bg": "chat_inBubble", "fg": "chat_inFileNameText", "kind": "text"},
    {"id": "in_file_info", "bg": "chat_inBubble", "fg": "chat_inFileInfoText", "kind": "text"},
    {"id": "out_file_name", "bg": "chat_outBubble", "fg": "chat_outFileNameText", "kind": "text"},
    {"id": "out_file_info", "bg": "chat_outBubble", "fg": "chat_outFileInfoText", "kind": "text"},
    {"id": "in_audio_duration", "bg": "chat_inBubble", "fg": "chat_inAudioDurationText", "kind": "text"},
    {"id": "out_audio_duration", "bg": "chat_outBubble", "fg": "chat_outAudioDurationText", "kind": "text"},
    {"id": "messagepanel_text", "bg": "chat_messagePanelBackground", "fg": "chat_messagePanelText", "kind": "text"},
    {"id": "messagepanel_icon", "bg": "chat_messagePanelBackground", "fg": "chat_messagePanelIcons", "kind": "icon"},
    {"id": "messagepanel_hint", "bg": "chat_messagePanelBackground", "fg": "chat_messagePanelHint", "kind": "text"},
    {"id": "player_title", "bg": "inappPlayerBackground", "fg": "inappPlayerTitle", "kind": "text"},
    {"id": "player_performer", "bg": "inappPlayerBackground", "fg": "inappPlayerPerformer", "kind": "text"},
    {"id": "dialog_text", "bg": "dialogBackground", "fg": "dialogTextBlack", "kind": "text"},
    {"id": "dialog_button", "bg": "dialogBackground", "fg": "dialogButton", "kind": "text"},
    {"id": "avatar_icon_on_bg", "bg": "avatar_backgroundBlue", "fg": "avatar_actionBarIconBlue", "kind": "icon"}
  ],
  "distinct_pairs": [
    {"id": "tab_selected_vs_unselected", "a": "actionBarTabActiveText", "b": "actionBarTabUnactiveText", "note": "Selected and unselected tab text must not resolve to the same color, or the active tab becomes indistinguishable."},
    {"id": "unread_vs_muted_counter_bg", "a": "chats_unreadCounter", "b": "chats_unreadCounterMuted", "note": "Muted chats' counter should look visually different (usually duller) from unmuted ones."},
    {"id": "in_vs_out_bubble_bg", "a": "chat_inBubble", "b": "chat_outBubble", "note": "Incoming/outgoing bubbles sharing one color makes message direction unreadable at a glance."},
    {"id": "dialog_button_vs_bg", "a": "dialogButton", "b": "dialogBackground", "note": "A dialog button matching the dialog's own background is invisible."},
    {"id": "title_vs_subtitle_appbar", "a": "actionBarDefaultTitle", "b": "actionBarDefaultSubtitle", "note": "A subtitle rendered in the same color as the title loses the visual hierarchy between them."},
    {"id": "chatname_vs_message", "a": "chats_name", "b": "chats_message", "note": "The chat name and its message preview must read as visually distinct (name = primary, preview = secondary)."},
    {"id": "messagepanel_text_vs_hint", "a": "chat_messagePanelText", "b": "chat_messagePanelHint", "note": "A placeholder hint that looks identical to actually-typed text defeats the point of a hint."},
    {"id": "player_title_vs_performer", "a": "inappPlayerTitle", "b": "inappPlayerPerformer", "note": "Track title and performer should read as primary/secondary, not identical."},
    {"id": "filename_vs_fileinfo_in", "a": "chat_inFileNameText", "b": "chat_inFileInfoText", "note": "A file's name and its info line (size/progress) should be visually distinct."},
    {"id": "filename_vs_fileinfo_out", "a": "chat_outFileNameText", "b": "chat_outFileInfoText", "note": "A file's name and its info line (size/progress) should be visually distinct."}
  ]
}
