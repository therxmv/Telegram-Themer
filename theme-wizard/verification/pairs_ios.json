{
  "_comment": "Foreground/background dot-path key pairs for the iOS (.tgios-theme) template. 'role:X' as bg/fg means look the value up directly from the resolved tint schema instead of a template key.",
  "text_pairs": [
    {"id": "navbar_title", "bg": "root.navBar.background", "fg": "root.navBar.primaryText", "kind": "text"},
    {"id": "navbar_secondary", "bg": "root.navBar.background", "fg": "root.navBar.secondaryText", "kind": "text"},
    {"id": "navbar_button", "bg": "root.navBar.background", "fg": "root.navBar.button", "kind": "text"},
    {"id": "tabbar_text", "bg": "root.tabBar.background", "fg": "root.tabBar.text", "kind": "text"},
    {"id": "tabbar_selected_text", "bg": "root.tabBar.background", "fg": "root.tabBar.selectedText", "kind": "text"},
    {"id": "tabbar_badge", "bg": "root.tabBar.badgeBackground", "fg": "root.tabBar.badgeText", "kind": "text"},
    {"id": "navbar_badge", "bg": "root.navBar.badgeFill", "fg": "root.navBar.badgeText", "kind": "text"},
    {"id": "list_primary", "bg": "list.itemBlocksBg", "fg": "list.primaryText", "kind": "text"},
    {"id": "list_secondary", "bg": "list.itemBlocksBg", "fg": "list.secondaryText", "kind": "text"},
    {"id": "in_bubble_primary", "bg": "chat.message.incoming.bubble.withoutWp.bg", "fg": "chat.message.incoming.primaryText", "kind": "text"},
    {"id": "in_bubble_secondary", "bg": "chat.message.incoming.bubble.withoutWp.bg", "fg": "chat.message.incoming.secondaryText", "kind": "text"},
    {"id": "out_bubble_primary", "bg": "chat.message.outgoing.bubble.withoutWp.bg", "fg": "chat.message.outgoing.primaryText", "kind": "text"},
    {"id": "out_bubble_secondary", "bg": "chat.message.outgoing.bubble.withoutWp.bg", "fg": "chat.message.outgoing.secondaryText", "kind": "text"},
    {"id": "in_reaction_active", "bg": "chat.message.incoming.bubble.withoutWp.reactionActiveBg", "fg": "chat.message.incoming.bubble.withoutWp.reactionActiveFg", "kind": "icon"},
    {"id": "in_reaction_inactive", "bg": "chat.message.incoming.bubble.withoutWp.reactionInactiveBg", "fg": "chat.message.incoming.bubble.withoutWp.reactionInactiveFg", "kind": "icon"},
    {"id": "inputpanel_text", "bg": "chat.inputPanel.inputBg", "fg": "chat.inputPanel.inputText_v2", "kind": "text"},
    {"id": "inputpanel_placeholder", "bg": "chat.inputPanel.inputBg", "fg": "chat.inputPanel.inputPlaceholder_v2", "kind": "text"},
    {"id": "inputpanel_send_button", "bg": "chat.inputPanel.actionControlBg", "fg": "chat.inputPanel.actionControlFg", "kind": "icon"},
    {"id": "actionsheet_destructive", "bg": "actionSheet.itemBg", "fg": "actionSheet.destructiveActionText", "kind": "text"}
  ],
  "distinct_pairs": [
    {"id": "tabbar_selected_vs_unselected", "a": "root.tabBar.selectedText", "b": "root.tabBar.text", "note": "Selected and unselected tab text must not resolve to the same color."},
    {"id": "in_reaction_active_vs_inactive_bg", "a": "chat.message.incoming.bubble.withoutWp.reactionActiveBg", "b": "chat.message.incoming.bubble.withoutWp.reactionInactiveBg", "note": "A tapped/active reaction pill must look different from an inactive one."},
    {"id": "in_vs_out_bubble_bg", "a": "chat.message.incoming.bubble.withoutWp.bg", "b": "chat.message.outgoing.bubble.withoutWp.bg", "note": "Incoming/outgoing bubbles sharing one color makes message direction unreadable at a glance."},
    {"id": "navbar_title_vs_secondary", "a": "root.navBar.primaryText", "b": "root.navBar.secondaryText", "note": "Primary and secondary nav bar text should read as visually distinct."},
    {"id": "list_primary_vs_secondary", "a": "list.primaryText", "b": "list.secondaryText", "note": "Primary and secondary list text should read as visually distinct."},
    {"id": "in_bubble_primary_vs_secondary", "a": "chat.message.incoming.primaryText", "b": "chat.message.incoming.secondaryText", "note": "Primary and secondary text on an incoming bubble should read as visually distinct."},
    {"id": "out_bubble_primary_vs_secondary", "a": "chat.message.outgoing.primaryText", "b": "chat.message.outgoing.secondaryText", "note": "Primary and secondary text on an outgoing bubble should read as visually distinct."},
    {"id": "inputpanel_text_vs_placeholder", "a": "chat.inputPanel.inputText_v2", "b": "chat.inputPanel.inputPlaceholder_v2", "note": "A placeholder hint that looks identical to actually-typed text defeats the point of a hint."}
  ]
}
